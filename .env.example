# PostgreSQL connection used by Next.js and Drizzle Kit
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Initial credentials (generate unique passwords; never commit .env)
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-random-password
ADMIN_PATH=ops-7k2m9x4q
DESKTOP_PASSWORD=replace-with-a-different-strong-random-password
# Keep this optional key stable; it additionally protects the stored desktop password.
AUTH_KEY=replace-with-a-random-32-byte-key

# GitHub source followed by the update checker; branch is auto-detected by default.
UPSTREAM_REPOSITORY=https://github.com/nocproen/des11.git
# UPSTREAM_BRANCH=master

# Concurrent desktop logins. 1 = legacy single-session behaviour, 3 = default.
DESKTOP_MAX_SESSIONS=3

# Production listener. PORT can be overridden by the hosting platform.
BIND_HOST=0.0.0.0
PORT=3000

# Updates are intentionally opt-in; enable both only with a restart manager.
AUTO_UPDATE=0
UPDATE_RESTART=0
UPDATE_INTERVAL_MIN=10
